{
  "name": "PDF Notizen",
  "short_name": "PDF Notizen",
  "description": "PDFs lesen, beschriften und per WhatsApp oder Mail weiterschicken.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f2937",
  "theme_color": "#1f2937",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf"] }]
    }
  }
}
